# Database (required for persistence, migrations, and integration tests)
# Use a dedicated local or test database. Never point this at production.
DATABASE_URL=mysql://app_user:change_me@127.0.0.1:3306/talent_incubation_dev

# Used only by docker-compose.dev.yml; change both values before first startup.
MYSQL_APP_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=local_root_password

# Application authentication
JWT_SECRET=replace-with-a-long-random-secret
VITE_APP_ID=your-app-id
OAUTH_SERVER_URL=https://your-oauth-server.example.com
OWNER_OPEN_ID=your-owner-open-id

# Manus Forge services (required only for storage, maps, image generation, etc.)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Optional integrations
OPENAI_API_KEY=
VITE_OAUTH_PORTAL_URL=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Server
PORT=3000
